<!DOCTYPE html>
<html lang="pt-BR" xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Propostas Pendentes - Área da Loja</title>
    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f4f6f8;
            color: #1f2937;
        }

        .topbar {
            background: #111827;
            color: #fff;
            padding: 20px 24px;
        }

        .container {
            max-width: 1100px;
            margin: 0 auto;
            padding: 24px;
        }

        .actions {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
            margin: 16px 0 24px;
        }

        .actions a,
        .actions button {
            display: inline-block;
            border: 0;
            border-radius: 8px;
            padding: 10px 14px;
            text-decoration: none;
            font-size: 14px;
            cursor: pointer;
        }

        .primary {
            background: #2563eb;
            color: #fff;
        }

        .secondary {
            background: #e5e7eb;
            color: #111827;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            background: #fff;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
        }

        th, td {
            padding: 14px;
            border-bottom: 1px solid #e5e7eb;
            text-align: left;
        }

        th {
            background: #f9fafb;
        }

        .empty {
            background: #fff;
            border-radius: 12px;
            padding: 18px;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
        }
        
        .badge {
            display: inline-block;
            padding: 4px 8px;
            border-radius: 6px;
            font-size: 12px;
            font-weight: bold;
            background: #fef3c7;
            color: #92400e;
        }
    </style>
</head>
<body>
<header class="topbar">
    <div class="container">
        <h1 th:text="'Propostas de ' + ${loja.nome}">Propostas Pendentes</h1>
        <p>Gerencie as propostas enviadas pelos clientes interessados nos seus veículos.</p>
    </div>
</header>

<main class="container">
    
    <div class="actions">
        <a class="secondary" th:href="@{/loja/home}">Home Loja</a>
        <a class="secondary" th:href="@{/loja/veiculos/cadastrar}">Cadastro de Veículo</a>
        <a class="secondary" th:href="@{/loja/veiculos}">Veículos da Loja</a>
        <a class="primary" th:href="@{/loja/propostas}">Propostas Pendentes</a>
        <a class="secondary" th:href="@{/logout}">Sair</a>
    </div>

    <section th:if="${propostas == null or #lists.isEmpty(propostas)}" class="empty">
        Nenhuma proposta foi recebida por sua loja até o momento.
    </section>

    <table th:if="${propostas != null and !#lists.isEmpty(propostas)}">
        <thead>
        <tr>
            <th>ID</th>
            <th>Veículo</th>
            <th>Placa</th>
            <th>Valor Proposto</th>
            <th>Data</th>
            <th>Status</th>
        </tr>
        </thead>
        <tbody>
        <tr th:each="proposta : ${propostas}">
            <td th:text="${proposta.id}"></td>
            <td th:text="${proposta.veiculo != null ? proposta.veiculo.nome : 'Não especificado'}"></td>
            <td th:text="${proposta.veiculo != null ? proposta.veiculo.placa : '-'}"></td>
            <td th:text="'R$ ' + ${#numbers.formatDecimal(proposta.valor, 1, 'POINT', 2, 'COMMA')}"></td>
            <td th:text="${proposta.data}"></td>
            <td>
                <span class="badge" th:text="${proposta.status}">ABERTO</span>
            </td>
        </tr>
        </tbody>
    </table>
</main>
</body>
</html>